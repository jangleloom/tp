@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "cmd:DeleteGameCommand" as DeleteCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("game delete 1 g/Minecraft")
activate LogicManager

LogicManager -> DeleteCommand : execute(model)
activate DeleteCommand

note right of DeleteCommand
  Validates target and
  stores personBeforeEdit,
  personAfterEdit internally
end note

DeleteCommand --> LogicManager : CommandResult\n(isAwaitingConfirmation=true)
deactivate DeleteCommand

note right of LogicManager
  Stores pendingConfirmableCommand
  and pendingDeletePerson
end note

[<-- LogicManager : show confirmation prompt
deactivate LogicManager

== User types "y" ==

[-> LogicManager : execute("y")
activate LogicManager

LogicManager -> DeleteCommand : performDeletion(model)
activate DeleteCommand

DeleteCommand -> Model : setPerson(before, after)
activate Model
Model --> DeleteCommand
deactivate Model

DeleteCommand --> LogicManager : CommandResult (success)
deactivate DeleteCommand

LogicManager -> Storage : saveAddressBook(...)
activate Storage
Storage --> LogicManager
deactivate Storage

[<-- LogicManager : show success message
deactivate LogicManager

@enduml
